PORT=3001
HOST=127.0.0.1
# Optional host port for the local Docker demonstration.
DEMO_PORT=8080
# Comma-separated exact origins for custom domains or production (HTTPS).
# Local HTTP loopback origins are allowed automatically outside production.
ALLOWED_ORIGINS=
DATABASE_PATH=data/kedu.sqlite
DEMO_PASSWORD=Kedu-demo-2026!
DEMO_SEED=true
# GLPI 10 REST API, read-only. demo = fictitious tickets; real = reads the authorized groups.
# Never commit tokens. Example URL: https://glpi.exemplo.com.br/apirest.php
GLPI_MODE=demo
GLPI_URL=
GLPI_VERSION=10.0.26
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Group names separated by ";" (exact match) or numeric ids in GLPI_GROUP_IDS.
GLPI_GROUPS=JURIDICO CONTRATOS;JURIDICO REVISÃO
GLPI_GROUP_IDS=
# CommonITILActor types: 1 requester, 2 assigned, 3 observer.
GLPI_ACTOR_TYPES=2
GLPI_TIMEOUT_MS=15000
GLPI_MAX_TICKETS=200
# Busca adicional de pendentes, inclusive antigos, com validação dos grupos.
GLPI_INCLUDE_PENDING=true
GLPI_MAX_PENDING=200
GLPI_INCLUDE_OPEN=true
GLPI_MAX_OPEN=2000
GLPI_PAGE_SIZE=50
GLPI_RETRIES=2
# 0 disables scheduling; 5 to 1440 minutes enables periodic reading.
GLPI_SYNC_INTERVAL_MINUTES=0
GLPI_SYNC_TIMES=07:00,12:00,16:00
# Backups locais: 0 desativa; produção recomenda 6 horas e cópia externa.
BACKUP_INTERVAL_HOURS=0
BACKUP_DIR=data/backups
# Apenas diagnóstico/preparação. Runtime atual ainda usa SQLite.
SUPABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_CA_PATH=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=kedu-documentos
