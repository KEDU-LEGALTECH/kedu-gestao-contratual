{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["yul1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{server,shared,templates,node_modules/pdfjs-dist/standard_fonts,node_modules/pdfjs-dist/cmaps,node_modules/pdfjs-dist/wasm}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" }
  ]
}
