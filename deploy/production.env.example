# Copie para .env.production (não versionar). Não altere o .env local.
DOMAIN=contratos.exemplo.com.br
ALLOWED_ORIGINS=https://contratos.exemplo.com.br
DEMO_SEED=false
GLPI_MODE=real
GLPI_INCLUDE_PENDING=true
GLPI_INCLUDE_OPEN=true
GLPI_MAX_OPEN=2000
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_GROUP_IDS=
# Horários de sincronização (Brasília). Têm prioridade sobre GLPI_SYNC_INTERVAL_MINUTES.
GLPI_SYNC_TIMES=07:00,12:00,16:00
GLPI_RETRIES=2
BACKUP_INTERVAL_HOURS=6
BACKUP_DIR=/app/backups
# Quantos backups automáticos manter no servidor (28 = 7 dias a cada 6 horas). 0 mantém todos.
BACKUP_KEEP=28
# Cópia externa diária do backup verificado (outro disco ou pasta de rede montada no contêiner).
BACKUP_COPY_DIR=/app/backups-externos
BACKUP_COPY_KEEP=14
# Preparação de conexão, não ativa o Supabase no runtime atual.
SUPABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_CA_PATH=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=kedu-documentos
